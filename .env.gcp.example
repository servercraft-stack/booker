# =============================================================================
# .env.gcp.example — GCP Deployment Configuration
# =============================================================================
# Copy this file to .env.gcp and fill in your values.
# NEVER commit .env.gcp to version control.
# =============================================================================

# ─── GCP Project ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# ─── Artifact Registry ──────────────────────────────────────────────────────
AR_REPO_NAME=booker-app

# ─── Cloud SQL ───────────────────────────────────────────────────────────────
DB_INSTANCE_NAME=booker-db
DB_NAME=booker
DB_USER=booker_admin
DB_PASSWORD=your-strong-database-password

# ─── Cloud Run ───────────────────────────────────────────────────────────────
SERVICE_NAME=booker-api

# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-super-secret-key-min-50-chars
DEBUG=false
ALLOWED_HOSTS=booker-api-your-project.us-central1.run.app
CSRF_TRUSTED_ORIGINS=https://booker-api-your-project.us-central1.run.app

# ─── Redis (optional — for rate limiting) ────────────────────────────────────
# REDIS_URL=redis://127.0.0.1:6379/1

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Email ───────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_USE_TLS=true

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Web OAuth 2.0 Client ID from Google Cloud Console → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
