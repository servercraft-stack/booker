# =============================================================================
# Booker Backend - Railway Environment Configuration Template
# =============================================================================
# Set these variables in your Railway Project Dashboard under:
#   Your Service -> Variables
#
# NOTE: Railway automatically provides:
#   - DATABASE_URL (when you add a PostgreSQL plugin/service)
#   - PORT (the HTTP port Gunicorn will bind to)
#   - RAILWAY_PUBLIC_DOMAIN (your app's generated domain, e.g. xxx.up.railway.app)
# =============================================================================

# ─── 1. Django Core ──────────────────────────────────────────────────────────
# Required: Generate a secure key (e.g. `openssl rand -hex 32` or `python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'`)
DJANGO_SECRET_KEY=your-production-secret-key-min-50-chars

# Set to false in production
DEBUG=false

# Allowed Hosts: Comma-separated.
# Note: Railway public domain (*.up.railway.app) is automatically included by core/settings.py
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins: Comma-separated full URLs (e.g. https://your-domain.up.railway.app)
# Note: Railway's https://${RAILWAY_PUBLIC_DOMAIN} is automatically added by core/settings.py
CSRF_TRUSTED_ORIGINS=https://your-custom-domain.com

# Enable Swagger/Redoc API docs in production (true/false)
ENABLE_DOCS=false

# ─── 2. Database (PostgreSQL) ────────────────────────────────────────────────
# Automatically provided by Railway when you connect a PostgreSQL service.
# Format: postgresql://postgres:password@postgres.railway.internal:5432/railway
DATABASE_URL=postgresql://user:password@host:5432/database

# ─── 3. Startup & Migrations ─────────────────────────────────────────────────
# Automatically run 'python manage.py migrate --noinput' on deploy (default: true)
RUN_MIGRATIONS=true

# ─── 4. Gunicorn Tuning (Optional) ───────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# ─── 5. Redis (Optional - for Rate Limiting) ─────────────────────────────────
# Automatically provided if you attach a Redis service on Railway
# REDIS_URL=redis://default:password@redis.railway.internal:6379
RATELIMIT_ENABLE=false

# ─── 6. CORS & Frontend ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (e.g., your Vercel/Netlify frontend)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# Optional: Set to true if you want to allow all origins temporarily during testing
CORS_ALLOW_ALL_ORIGINS=false

# Frontend URL (used in email links, verification emails, password resets)
FRONTEND_URL=https://your-frontend.vercel.app

# ─── 7. Cloudinary (Media Storage) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ─── 8. Stripe (Payments) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=usd

# ─── 9. Email (SMTP / Port 587 TLS) ──────────────────────────────────────────
# NOTE: Email sending is OUTBOUND traffic (your app connects outward to the SMTP server).
# Railway does NOT require exposing or opening port 587 on your service for outbound email.
#
# Standard Port 587 (STARTTLS) Configuration:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your-email@gmail.com
# For Gmail: generate a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL="Booker <noreply@yourdomain.com>"

# Alternative Port 465 (SSL) Configuration (if you prefer Port 465):
# EMAIL_PORT=465
# EMAIL_USE_TLS=false
# EMAIL_USE_SSL=true

# ─── 10. Google OAuth ────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
